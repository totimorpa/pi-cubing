  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totimorpa/pi-cubing.git"
  },
  "bugs": {
    "url": "https://github.com/totimorpa/pi-cubing/issues"
  },
  "homepage": "https://github.com/totimorpa/pi-cubing#readme",
  "pi": {
